# SPDX-License-Identifier: MIT
# Death-test helpers: raw allocation, POSIX process calls and mutable test globals are the subject
# or the means of these tests. The root .clang-tidy still applies to everything else.
InheritParentConfig: true
Checks: >
  -cppcoreguidelines-avoid-c-arrays,
  -modernize-avoid-c-arrays,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-no-malloc,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-type-const-cast,
  -modernize-deprecated-headers,
  -cppcoreguidelines-pro-type-vararg
# avoid-c-arrays, array-to-pointer-decay: pipe file descriptors and argv arrays for posix_spawn.
# avoid-non-const-global-variables: volatile sinks that keep allocations observable; POSIX `environ`.
# no-malloc, owning-memory: the scenarios deliberately call new/delete/malloc/free.
# const-cast: posix_spawn takes char* const argv[]; the strings outlive the call.
# deprecated-headers: <time.h>/<unistd.h> POSIX headers.
# vararg: POSIX and Win32 APIs.
