{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pme:schema:instrument:1",
  "title": "Plucked physical modelling engine instrument file",
  "description": "One instrument as a versioned, human-readable document (SPEC-INST 'Instrument file'). Field names are the member names of the description structs of interfaces-v2 (SPEC-API 'Descriptions'); every numeric field records its SI unit in x-unit.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "enum": [
        "pme-instrument"
      ],
      "description": "File format marker (SPEC-INST Instrument file)"
    },
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ],
      "x-unit": "index",
      "description": "Schema version of this document; older versions are migrated on load (SPEC-INST Instrument file)"
    },
    "instrument": {
      "$ref": "#/$defs/InstrumentDesc",
      "description": "The instrument description (SPEC-API InstrumentDesc)"
    },
    "blobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BlobEntry"
      },
      "default": [],
      "description": "Blob manifest: binary data referenced by hash (SPEC-INST Instrument file)"
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "instrument"
  ],
  "additionalProperties": false,
  "$defs": {
    "Point": {
      "type": "object",
      "description": "A point in the body frame (types.hpp, SI-0003). (SPEC-API)",
      "properties": {
        "x": {
          "type": "number",
          "x-unit": "m",
          "description": "Case-frame x (SPEC-CONV)"
        },
        "y": {
          "type": "number",
          "x-unit": "m",
          "description": "Case-frame y (SPEC-CONV)"
        },
        "z": {
          "type": "number",
          "x-unit": "m",
          "description": "Normal to the plate, towards the strings (SPEC-CONV)"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false
    },
    "StringParams": {
      "type": "object",
      "description": "Physical description of one string (string.hpp). (SPEC-STR)",
      "properties": {
        "L": {
          "type": "number",
          "x-unit": "m",
          "exclusiveMinimum": 0,
          "description": "Speaking length L (SPEC-STR)"
        },
        "dCore": {
          "type": "number",
          "x-unit": "m",
          "exclusiveMinimum": 0,
          "description": "Core diameter d_c (SPEC-STR Wound strings)"
        },
        "rhoCore": {
          "type": "number",
          "x-unit": "kg/m^3",
          "exclusiveMinimum": 0,
          "description": "Core density rho_c (SPEC-STR)"
        },
        "ECore": {
          "type": "number",
          "x-unit": "Pa",
          "exclusiveMinimum": 0,
          "description": "Core Young's modulus E_c (SPEC-STR)"
        },
        "dOuter": {
          "type": "number",
          "x-unit": "m",
          "exclusiveMinimum": 0,
          "description": "Outer (winding) diameter d_o; at least dCore (SPEC-STR Wound strings)"
        },
        "rhoWind": {
          "type": "number",
          "x-unit": "kg/m^3",
          "exclusiveMinimum": 0,
          "description": "Winding density rho_w (SPEC-STR)"
        },
        "packing": {
          "type": "number",
          "x-unit": "1",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Winding packing factor eta_w, 0.75 to 0.9 for round wire (SPEC-STR)"
        },
        "epsWind": {
          "type": "number",
          "x-unit": "1",
          "minimum": 0,
          "description": "Winding stiffness fraction eps_w of the core EI (SPEC-STR)"
        },
        "f1Target": {
          "type": "number",
          "x-unit": "Hz",
          "exclusiveMinimum": 0,
          "description": "Target first-partial frequency f_1 (replaced by the tuning curve when key >= 0) (SPEC-STR Tension for pitch, SI-0004)"
        },
        "b1": {
          "type": "number",
          "x-unit": "1/s",
          "minimum": 0,
          "description": "Intrinsic loss b_1 (SPEC-STR Losses)"
        },
        "b2": {
          "type": "number",
          "x-unit": "s^(-1/2)",
          "minimum": 0,
          "description": "Intrinsic loss b_2 (SPEC-STR Losses)"
        },
        "b3": {
          "type": "number",
          "x-unit": "s",
          "minimum": 0,
          "description": "Intrinsic loss b_3 (SPEC-STR Losses)"
        },
        "sigmaOverride": {
          "type": "array",
          "items": {
            "type": "number",
            "x-unit": "1/s",
            "minimum": 0
          },
          "x-unit": "1/s",
          "description": "Optional per-partial sigma_n; empty = use b1..b3 (SPEC-STR Losses)"
        },
        "boundary": {
          "type": "string",
          "enum": [
            "Pinned",
            "Clamped"
          ],
          "default": "Pinned",
          "description": "End conditions (SPEC-STR Modes)"
        },
        "detuneH": {
          "type": "number",
          "x-unit": "cent",
          "description": "Horizontal-polarisation detune Delta_h (SPEC-STR Polarisations)"
        },
        "bridgeEnd": {
          "type": "string",
          "enum": [
            "AtL",
            "At0"
          ],
          "default": "AtL",
          "description": "Which end moves with the bridge (SPEC-BRG Decomposition)"
        }
      },
      "required": [
        "L",
        "dCore",
        "rhoCore",
        "ECore",
        "dOuter",
        "rhoWind",
        "packing",
        "epsWind",
        "f1Target",
        "b1",
        "b2",
        "b3",
        "sigmaOverride",
        "detuneH"
      ],
      "additionalProperties": false
    },
    "HammerParams": {
      "type": "object",
      "description": "Hammer parameters (exciters.hpp). (SPEC-HAM)",
      "properties": {
        "mass": {
          "type": "number",
          "x-unit": "kg",
          "exclusiveMinimum": 0,
          "description": "Hammer mass m_H (SPEC-HAM)"
        },
        "K": {
          "type": "number",
          "x-unit": "N/m^p",
          "exclusiveMinimum": 0,
          "description": "Felt stiffness K (SPEC-HAM Contact)"
        },
        "p": {
          "type": "number",
          "x-unit": "1",
          "exclusiveMinimum": 0,
          "description": "Felt exponent p (SPEC-HAM)"
        },
        "muHC": {
          "type": "number",
          "x-unit": "s/m",
          "minimum": 0,
          "description": "Hunt-Crossley hysteresis mu_HC (SPEC-HAM)"
        },
        "width": {
          "type": "number",
          "x-unit": "m",
          "exclusiveMinimum": 0,
          "description": "Contact window width b_H (SPEC-HAM)"
        },
        "strikeRatio": {
          "type": "number",
          "x-unit": "1",
          "minimum": 0,
          "maximum": 1,
          "description": "Strike position beta_c = x_c / L (SPEC-HAM)"
        },
        "law": {
          "type": "string",
          "enum": [
            "HuntCrossley",
            "Stulov"
          ],
          "default": "HuntCrossley",
          "description": "Felt dissipation law (SPEC-HAM Felt dissipation)"
        },
        "stulovEps": {
          "type": "number",
          "x-unit": "1",
          "minimum": 0,
          "description": "Stulov hereditary amplitude epsilon (SPEC-HAM Alternative: Stulov)"
        },
        "stulovTau": {
          "type": "number",
          "x-unit": "s",
          "minimum": 0,
          "description": "Stulov relaxation time tau (SPEC-HAM Alternative: Stulov)"
        },
        "vMin": {
          "type": "number",
          "x-unit": "m/s",
          "minimum": 0,
          "default": 0.3,
          "description": "v_min of the velocity map (SPEC-HAM)"
        },
        "vMax": {
          "type": "number",
          "x-unit": "m/s",
          "exclusiveMinimum": 0,
          "default": 6,
          "description": "v_max of the velocity map (SPEC-HAM)"
        },
        "gammaV": {
          "type": "number",
          "x-unit": "1",
          "exclusiveMinimum": 0,
          "default": 1.5,
          "description": "gamma_v of the velocity map (SPEC-HAM)"
        },
        "dCheck": {
          "type": "number",
          "x-unit": "m",
          "minimum": 0,
          "default": 0.005,
          "description": "Release distance d_check (SPEC-HAM)"
        }
      },
      "required": [
        "mass",
        "K",
        "p",
        "muHC",
        "width",
        "strikeRatio",
        "stulovEps",
        "stulovTau"
      ],
      "additionalProperties": false
    },
    "UnaCordaParams": {
      "type": "object",
      "description": "Una corda and soft-pedal parameters (exciters.hpp). (SPEC-HAM)",
      "properties": {
        "s0": {
          "type": "number",
          "x-unit": "1",
          "minimum": 0,
          "maximum": 1,
          "default": 0.3,
          "description": "Smoothstep lower bound s_0 (SPEC-HAM Una corda (grand))"
        },
        "s1": {
          "type": "number",
          "x-unit": "1",
          "minimum": 0,
          "maximum": 1,
          "default": 0.9,
          "description": "Smoothstep upper bound s_1 (SPEC-HAM Una corda (grand))"
        },
        "kappaUC": {
          "type": "number",
          "x-unit": "1",
          "minimum": 0,
          "default": 0.6,
          "description": "Stiffness factor kappa_uc (SPEC-HAM Una corda (grand))"
        },
        "deltaPUC": {
          "type": "number",
          "x-unit": "1",
          "default": 0,
          "description": "Exponent shift Delta p_uc (SPEC-HAM Una corda (grand))"
        },
        "rhoUpright": {
          "type": "number",
          "x-unit": "1",
          "minimum": 0,
          "maximum": 1,
          "default": 0.3,
          "description": "Upright soft-pedal velocity scale rho_up (SPEC-HAM Soft pedal (upright))"
        },
        "leavingString": {
          "type": "integer",
          "x-unit": "index",
          "minimum": -1,
          "maximum": 2147483647,
          "default": 0,
          "description": "Zero-based index of the string that leaves the hammer; -1 for none (SPEC-HAM String that leaves the hammer)"
        }
      },
      "additionalProperties": false
    },
    "PluckPulse": {
      "type": "object",
      "description": "Generic force-pulse pluck (exciters.hpp). (SPEC-PLK)",
      "properties": {
        "duration": {
          "type": "number",
          "x-unit": "s",
          "exclusiveMinimum": 0,
          "description": "Pulse duration t_p (SPEC-PLK)"
        },
        "peakForceMax": {
          "type": "number",
          "x-unit": "N",
          "exclusiveMinimum": 0,
          "description": "Peak force F_p,max at strength 1 (SPEC-PLK Strength map)"
        },
        "position": {
          "type": "number",
          "x-unit": "m",
          "minimum": 0,
          "description": "Window centre x_p on the segment's x axis (SPEC-PLK)"
        },
        "width": {
          "type": "number",
          "x-unit": "m",
          "exclusiveMinimum": 0,
          "description": "Window width b_p (SPEC-PLK)"
        },
        "angle": {
          "type": "number",
          "x-unit": "rad",
          "description": "Polarisation angle theta_p (SPEC-PLK)"
        },
        "strengthGamma": {
          "type": "number",
          "x-unit": "1",
          "exclusiveMinimum": 0,
          "default": 1,
          "description": "gamma_p of the strength map (SPEC-PLK Strength map)"
        }
      },
      "required": [
        "duration",
        "peakForceMax",
        "position",
        "width",
        "angle"
      ],
      "additionalProperties": false
    },
    "Plectrum": {
      "type": "object",
      "description": "Plectrum: pick, quill, mizrab or bachi (exciters.hpp). (SPEC-PLK)",
      "properties": {
        "tipMass": {
          "type": "number",
          "x-unit": "kg",
          "exclusiveMinimum": 0,
          "description": "Tip mass m_p (SPEC-PLK)"
        },
        "driverStiffness": {
          "type": "number",
          "x-unit": "N/m",
          "exclusiveMinimum": 0,
          "description": "Spring K_p between tip and driver (SPEC-PLK)"
        },
        "driverSpeedMax": {
          "type": "number",
          "x-unit": "m/s",
          "exclusiveMinimum": 0,
          "description": "Driver speed v_d,max at strength 1 (SPEC-PLK)"
        },
        "slipHeight": {
          "type": "number",
          "x-unit": "m",
          "minimum": 0,
          "description": "Release threshold h_slip (SPEC-PLK)"
        },
        "contactK": {
          "type": "number",
          "x-unit": "N/m^alpha",
          "exclusiveMinimum": 0,
          "description": "Contact stiffness K of the one-sided power law (SPEC-PLK)"
        },
        "contactAlpha": {
          "type": "number",
          "x-unit": "1",
          "exclusiveMinimum": 0,
          "description": "Contact exponent alpha (SPEC-PLK)"
        },
        "position": {
          "type": "number",
          "x-unit": "m",
          "minimum": 0,
          "description": "Default pluck position x_p on the segment's x axis (SPEC-PLK)"
        },
        "angle": {
          "type": "number",
          "x-unit": "rad",
          "description": "Pluck direction theta_p (SPEC-PLK)"
        },
        "strengthGamma": {
          "type": "number",
          "x-unit": "1",
          "exclusiveMinimum": 0,
          "default": 1,
          "description": "gamma_p of the strength map (SPEC-PLK Strength map)"
        }
      },
      "required": [
        "tipMass",
        "driverStiffness",
        "driverSpeedMax",
        "slipHeight",
        "contactK",
        "contactAlpha",
        "position",
        "angle"
      ],
      "additionalProperties": false
    },
    "Finger": {
      "type": "object",
      "description": "Finger with a wide soft Hunt-Crossley flesh contact (exciters.hpp, SI-0005). (SPEC-PLK)",
      "properties": {
        "tipMass": {
          "type": "number",
          "x-unit": "kg",
          "exclusiveMinimum": 0,
          "description": "Finger tip mass m_f (SPEC-PLK)"
        },
        "driverStiffness": {
          "type": "number",
          "x-unit": "N/m",
          "exclusiveMinimum": 0,
          "description": "Driver spring K_f between tip and driver (SPEC-PLK)"
        },
        "driverSpeedMax": {
          "type": "number",
          "x-unit": "m/s",
          "exclusiveMinimum": 0,
          "description": "Driver speed v_d,max at strength 1 (SPEC-PLK)"
        },
        "slipHeight": {
          "type": "number",
          "x-unit": "m",
          "minimum": 0,
          "description": "Release threshold h_slip,f (SPEC-PLK)"
        },
        "contactK": {
          "type": "number",
          "x-unit": "N/m^alpha",
          "exclusiveMinimum": 0,
          "description": "Flesh contact stiffness K_c,f (SPEC-PLK)"
        },
        "contactAlpha": {
          "type": "number",
          "x-unit": "1",
          "exclusiveMinimum": 0,
          "description": "Contact exponent alpha_f (SPEC-PLK)"
        },
        "muFlesh": {
          "type": "number",
          "x-unit": "s/m",
          "minimum": 0,
          "description": "Hunt-Crossley flesh damping mu_f (SPEC-PLK)"
        },
        "width": {
          "type": "number",
          "x-unit": "m",
          "exclusiveMinimum": 0,
          "description": "Raised-cosine contact width b_f (SPEC-PLK)"
        },
        "position": {
          "type": "number",
          "x-unit": "m",
          "minimum": 0,
          "description": "Default pluck position x_p on the segment's x axis (SPEC-PLK)"
        },
        "angle": {
          "type": "number",
          "x-unit": "rad",
          "description": "Pluck direction theta_p (SPEC-PLK)"
        },
        "strengthGamma": {
          "type": "number",
          "x-unit": "1",
          "exclusiveMinimum": 0,
          "default": 1,
          "description": "gamma_p of the strength map (SPEC-PLK Strength map)"
        }
      },
      "required": [
        "tipMass",
        "driverStiffness",
        "driverSpeedMax",
        "slipHeight",
        "contactK",
        "contactAlpha",
        "muFlesh",
        "width",
        "position",
        "angle"
      ],
      "additionalProperties": false
    },
    "InitialDisplacement": {
      "type": "object",
      "description": "Initial displacement exciter (exciters.hpp). (SPEC-PLK)",
      "properties": {
        "amplitudeMax": {
          "type": "number",
          "x-unit": "m",
          "exclusiveMinimum": 0,
          "description": "Triangle height A_max at strength 1 (SPEC-PLK)"
        },
        "position": {
          "type": "number",
          "x-unit": "m",
          "minimum": 0,
          "description": "Default apex position x_p on the segment's x axis (SPEC-PLK)"
        },
        "angle": {
          "type": "number",
          "x-unit": "rad",
          "description": "Polarisation angle theta_p (SPEC-PLK)"
        },
        "strengthGamma": {
          "type": "number",
          "x-unit": "1",
          "exclusiveMinimum": 0,
          "default": 1,
          "description": "gamma_p of the strength map (SPEC-PLK Strength map)"
        }
      },
      "required": [
        "amplitudeMax",
        "position",
        "angle"
      ],
      "additionalProperties": false
    },
    "ExciterParams": {
      "type": "object",
      "description": "An exciter: an object with exactly one key naming the alternative. (SPEC-API)",
      "properties": {
        "hammer": {
          "$ref": "#/$defs/HammerParams",
          "description": "Hammer (SPEC-HAM)"
        },
        "pluckPulse": {
          "$ref": "#/$defs/PluckPulse",
          "description": "Force pulse (SPEC-PLK)"
        },
        "plectrum": {
          "$ref": "#/$defs/Plectrum",
          "description": "Plectrum (SPEC-PLK)"
        },
        "finger": {
          "$ref": "#/$defs/Finger",
          "description": "Finger (SPEC-PLK)"
        },
        "initialDisplacement": {
          "$ref": "#/$defs/InitialDisplacement",
          "description": "Initial displacement (SPEC-PLK)"
        }
      },
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false
    },
    "DamperParams": {
      "type": "object",
      "description": "Damper parameters (dampers.hpp). (SPEC-DMP)",
      "properties": {
        "xRatio": {
          "type": "number",
          "x-unit": "1",
          "minimum": 0,
          "maximum": 1,
          "description": "Pad centre x_d / L (SPEC-DMP Damper model)"
        },
        "width": {
          "type": "number",
          "x-unit": "m",
          "exclusiveMinimum": 0,
          "description": "Pad width b_d (SPEC-DMP)"
        },
        "Kd": {
          "type": "number",
          "x-unit": "N/m",
          "exclusiveMinimum": 0,
          "description": "Pad stiffness K_d (SPEC-DMP)"
        },
        "Rd": {
          "type": "number",
          "x-unit": "kg/s",
          "minimum": 0,
          "description": "Pad resistance R_d (SPEC-DMP)"
        },
        "tau0": {
          "type": "number",
          "x-unit": "s",
          "exclusiveMinimum": 0,
          "default": 0.012,
          "description": "Landing time constant tau_0 (SPEC-DMP Timing)"
        },
        "kRelease": {
          "type": "number",
          "x-unit": "1",
          "exclusiveMinimum": 0,
          "default": 2,
          "description": "Release-velocity factor k_r (SPEC-DMP Timing)"
        },
        "tauUp": {
          "type": "number",
          "x-unit": "s",
          "exclusiveMinimum": 0,
          "default": 0.004,
          "description": "Lift time constant tau_up (SPEC-DMP Timing)"
        },
        "etaD": {
          "type": "number",
          "x-unit": "1",
          "exclusiveMinimum": 0,
          "default": 2,
          "description": "Contact shape exponent eta_d (SPEC-DMP Lift fraction)"
        },
        "hasDamper": {
          "type": "boolean",
          "default": true,
          "description": "False for the undamped top keys (SPEC-DMP Undamped notes)"
        },
        "mode": {
          "type": "string",
          "enum": [
            "Diagonal",
            "RankOne"
          ],
          "default": "Diagonal",
          "description": "Diagonal or rank-one (SPEC-DMP Damper model)"
        }
      },
      "required": [
        "xRatio",
        "width",
        "Kd",
        "Rd"
      ],
      "additionalProperties": false
    },
    "BarrierParams": {
      "type": "object",
      "description": "Distributed barrier (barriers.hpp). (SPEC-PLK)",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "Custom",
            "Fret",
            "Fretboard",
            "Jawari",
            "Thread",
            "Sawari"
          ],
          "default": "Custom",
          "description": "Geometry family (SPEC-PLK Barrier geometries)"
        },
        "x": {
          "type": "array",
          "items": {
            "type": "number",
            "x-unit": "m"
          },
          "x-unit": "m",
          "description": "Sample positions x_j along the string (SPEC-PLK Distributed barriers)"
        },
        "b": {
          "type": "array",
          "items": {
            "type": "number",
            "x-unit": "m"
          },
          "x-unit": "m",
          "description": "Profile b(x_j) (SPEC-PLK Distributed barriers)"
        },
        "w": {
          "type": "array",
          "items": {
            "type": "number",
            "x-unit": "m"
          },
          "x-unit": "m",
          "description": "Quadrature weights Delta x_j (SPEC-PLK Distributed barriers)"
        },
        "side": {
          "type": "integer",
          "x-unit": "1",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "enum": [
            -1,
            1
          ],
          "default": 1,
          "description": "Side s_b, +1 or -1 (SPEC-PLK Distributed barriers)"
        },
        "K": {
          "type": "number",
          "x-unit": "N/m^(alpha+1)",
          "minimum": 0,
          "description": "Contact stiffness K_B (SPEC-PLK Distributed barriers)"
        },
        "alpha": {
          "type": "number",
          "x-unit": "1",
          "exclusiveMinimum": 0,
          "description": "Contact exponent alpha (SPEC-PLK Distributed barriers)"
        },
        "muB": {
          "type": "number",
          "x-unit": "s/m",
          "minimum": 0,
          "description": "Contact damping mu_B (SPEC-PLK Distributed barriers)"
        }
      },
      "required": [
        "x",
        "b",
        "w",
        "K",
        "alpha",
        "muB"
      ],
      "additionalProperties": false
    },
    "SegmentDesc": {
      "type": "object",
      "description": "One string segment of a note group (instrument.hpp). (SPEC-INST)",
      "properties": {
        "string": {
          "$ref": "#/$defs/StringParams",
          "description": "The string (SPEC-STR)"
        },
        "bridgePoint": {
          "type": "integer",
          "x-unit": "index",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "Index into instrument.bridgePoints (SPEC-BRG)"
        },
        "polarisationAngle": {
          "type": "number",
          "x-unit": "rad",
          "description": "Angle of the vertical polarisation axis (SPEC-BRG)"
        },
        "barriers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BarrierParams"
          },
          "description": "Barriers this segment collides with (SPEC-PLK)"
        },
        "damper": {
          "$ref": "#/$defs/DamperParams",
          "description": "Damper, if any (SPEC-DMP)"
        },
        "muteRatio": {
          "type": "number",
          "x-unit": "1",
          "minimum": 0,
          "maximum": 1,
