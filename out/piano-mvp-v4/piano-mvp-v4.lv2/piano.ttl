# SPDX-License-Identifier: MIT
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rsz: <http://lv2plug.in/ns/ext/resize-port#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<https://gbasilveira.github.io/plucked-physical-modeling-engine/mvp/piano-v4>
    a lv2:Plugin, lv2:InstrumentPlugin ;
    doap:name "Piano MVP 4 - Grand" ;
    doap:license <https://opensource.org/license/mit> ;
    lv2:minorVersion 7 ;
    lv2:microVersion 0 ;
    lv2:requiredFeature urid:map ;
    rdfs:comment "Experimental physical piano with velocity, sustain and a fixed preset; quality Live / Balanced / Full." ;
    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        lv2:index 0 ; lv2:symbol "midi_in" ; lv2:name "MIDI input" ;
        atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent ;
        rsz:minimumSize 4096
    ], [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 1 ; lv2:symbol "out_l" ; lv2:name "Left"
    ], [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 2 ; lv2:symbol "out_r" ; lv2:name "Right"
    ], [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ; lv2:symbol "quality" ; lv2:name "Quality" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Live (real time)" ; rdf:value 0 ] ,
                       [ rdfs:label "Balanced" ; rdf:value 1 ] ,
                       [ rdfs:label "Full (offline model)" ; rdf:value 2 ]
    ], [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ; lv2:symbol "threads" ; lv2:name "Worker threads" ;
        lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 3 ;
        lv2:portProperty lv2:integer
    ], [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ; lv2:symbol "freewheel" ; lv2:name "Free-wheeling (offline: Full)" ;
        lv2:designation lv2:freeWheeling ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
        lv2:portProperty lv2:toggled, lv2:connectionOptional
    ], [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ; lv2:symbol "adaptive" ; lv2:name "Adaptive load shedding" ;
        lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ;
        lv2:portProperty lv2:toggled, lv2:connectionOptional
    ], [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ; lv2:symbol "imperfection" ; lv2:name "Imperfection" ;
        lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 2 ;
        rdfs:comment "0 = perfectly even strings (0.5.4); 1 = slightly mistuned unisons, uneven hammer contact, a few split partials; up to 2. A key takes a new value at its next note-on." ;
        lv2:portProperty lv2:connectionOptional
    ], [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ; lv2:symbol "voices" ; lv2:name "Voices" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ;
        rdfs:comment "Struck-voice limit for Live and Balanced: Auto = the quality's own cap, or 16 / 32 / 48 / 64. More voices keep long, overlapping pedalled chords complete at a higher CPU cost; adaptive load shedding still caps it." ;
        lv2:portProperty lv2:integer, lv2:enumeration, lv2:connectionOptional ;
        lv2:scalePoint [ rdfs:label "Auto" ; rdf:value 0 ] ,
                       [ rdfs:label "16" ; rdf:value 1 ] ,
                       [ rdfs:label "32" ; rdf:value 2 ] ,
                       [ rdfs:label "48" ; rdf:value 3 ] ,
                       [ rdfs:label "64" ; rdf:value 4 ]
    ], [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ; lv2:symbol "radiation" ; lv2:name "Radiation" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ;
        rdfs:comment "Soundboard radiation stage. Auto = baked bank for Live and Balanced, the 512-mode modal bank for Full; Modal and Baked force one. Baked drops the 246 board modes that radiate nothing and drives the rest in float: about -133 dB rms against Modal on the Chopin excerpt, 1.6 to 2.5 times cheaper. Switching clears the radiation tail of the bank being left." ;
        lv2:portProperty lv2:integer, lv2:enumeration, lv2:connectionOptional ;
        lv2:scalePoint [ rdfs:label "Auto" ; rdf:value 0 ] ,
                       [ rdfs:label "Modal (512 modes, reference)" ; rdf:value 1 ] ,
                       [ rdfs:label "Baked (reduced bank)" ; rdf:value 2 ]
    ], [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ; lv2:symbol "body" ; lv2:name "Body" ;
        lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ;
        rdfs:comment "Classic = the 0.6 board and radiation (sessions saved before 0.7c sound exactly as they did). Grand = the 0.7 grand: the strings couple to the FEM grand board with air loading, the board radiates through a shared-pole bank fitted to the 0.7b port-to-microphone responses, and the struck strings radiate directly. A change applies from the next note-on; sounding notes of the other body ring out." ;
        lv2:portProperty lv2:integer, lv2:enumeration, lv2:connectionOptional ;
        lv2:scalePoint [ rdfs:label "Classic (0.6)" ; rdf:value 0 ] ,
                       [ rdfs:label "Grand (0.7)" ; rdf:value 1 ]
    ], [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ; lv2:symbol "mic" ; lv2:name "Mic" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ;
        rdfs:comment "Body Grand: the stereo pair that is rendered. Close AB (12 cm above the strings, the Salamander style), Player (at the keyboard) or Audience (about 3 m from the tail). A change is a 20 ms crossfade." ;
        lv2:portProperty lv2:integer, lv2:enumeration, lv2:connectionOptional ;
        lv2:scalePoint [ rdfs:label "Close AB" ; rdf:value 0 ] ,
                       [ rdfs:label "Player" ; rdf:value 1 ] ,
                       [ rdfs:label "Audience" ; rdf:value 2 ]
    ], [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ; lv2:symbol "lid" ; lv2:name "Lid" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ;
        rdfs:comment "Body Grand: the lid state of the radiation (open, half open on the prop stick, closed). A change is a 20 ms crossfade; the radiation of the new state starts from rest." ;
        lv2:portProperty lv2:integer, lv2:enumeration, lv2:connectionOptional ;
        lv2:scalePoint [ rdfs:label "Open" ; rdf:value 0 ] ,
                       [ rdfs:label "Half" ; rdf:value 1 ] ,
                       [ rdfs:label "Closed" ; rdf:value 2 ]
    ] .
