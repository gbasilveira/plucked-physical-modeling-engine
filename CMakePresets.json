{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "os-linux",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "os-macos",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "os-windows",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "cfg-debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "cfg-release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "cfg-rt-safety",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "PME_RTSAFETY": "ON"
      }
    },
    {
      "name": "cfg-asan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PME_SANITIZER": "asan"
      }
    },
    {
      "name": "cfg-tsan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PME_SANITIZER": "tsan"
      }
    },
    {
      "name": "cfg-coverage",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PME_SANITIZER": "coverage"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "linux debug",
      "inherits": [
        "base",
        "os-linux",
        "cfg-debug"
      ]
    },
    {
      "name": "linux-release",
      "displayName": "linux release",
      "inherits": [
        "base",
        "os-linux",
        "cfg-release"
      ]
    },
    {
      "name": "linux-rt-safety",
      "displayName": "linux rt-safety",
      "inherits": [
        "base",
        "os-linux",
        "cfg-rt-safety"
      ]
    },
    {
      "name": "linux-asan",
      "displayName": "linux asan",
      "inherits": [
        "base",
        "os-linux",
        "cfg-asan"
      ]
    },
    {
      "name": "linux-tsan",
      "displayName": "linux tsan",
      "inherits": [
        "base",
        "os-linux",
        "cfg-tsan"
      ]
    },
    {
      "name": "linux-coverage",
      "displayName": "linux coverage",
      "inherits": [
        "base",
        "os-linux",
        "cfg-coverage"
      ]
    },
    {
      "name": "macos-debug",
      "displayName": "macos debug",
      "inherits": [
        "base",
        "os-macos",
        "cfg-debug"
      ]
    },
    {
